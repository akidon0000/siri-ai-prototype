@Tutorial(time: 15) {
    @Intro(title: "App Shortcutsでフレーズを固定する") {
        AppShortcutsProvider と AppShortcut で、決まった言い方からApp Intentを
        確実に呼び出せるようにする仕組みを、実際のフレーズ定義で理解する。

        教材: `docs/shortcuts/app-shortcuts.md`（Apple Developer Documentation原文）
    }

    @Section(title: "AppShortcutsProviderを書く") {
        @ContentAndMedia {
            App Shortcutは、App Intentに「タイトル・画像・話しかける言葉（フレーズ）」を
            組み合わせ、Shortcutsアプリや他のシステム機能で使いやすくする。
        }

        @Steps {
            @Step {
                `AppShortcutsProvider` に準拠した型を1つ作り、static な
                `appShortcuts` の中に `AppShortcut` を並べる。これだけで、
                アプリをインストールした時点でShortcutsアプリやSiriが
                自動的に見つけられるようになる。

                @Code(file: "03-app-shortcuts-provider.swift", name: "MemoShortcuts.swift")
            }

            @Step {
                `phrases` の中の `\(.applicationName)` はアプリ名に置き換わるトークン。
                `\(\.$title)` のように `\.$パラメータ名` を書くと、その場所に
                Siriが聞き取った値（メモのタイトル）がそのまま入る。

                あらかじめパラメータが決まっている場合は、毎回聞き直さずに
                一発で実行できるフレーズも用意できる
                （例: いつものトレイルでハイキングを開始する）。
            }

            @Step {
                `shortTitle` と `systemImageName` は、Shortcutsアプリや
                App Shortcutsのプラターに表示される見た目。SF Symbolsの名前を
                そのまま使える。
            }
        }
    }

    @Section(title: "アプリ内でフレーズを教える") {
        @ContentAndMedia {
            Shortcutsアプリは自動的に見つけてくれるが、アプリを使っている人にも
            「この言い方で呼び出せます」と教えたい場面がある。
        }

        @Steps {
            @Step {
                `SiriTipView` / `SiriTipUIView` に対象の intent を渡すだけで、
                その intent に設定した `AppShortcut` のフレーズをヒントとして表示できる。

                @Code(file: "03-siri-tip-view.swift", name: "MemoListFooter.swift")
            }

            @Step {
                `ShortcutsLink` / `ShortcutsUIButton` を使うと、アプリの
                Shortcutsページを直接開くボタンも用意できる。
            }

            @Step {
                Appleは、ローカライズされたフレーズや表示名などの
                App Shortcutsデータを匿名化して学習に使う場合があると明記している。
                機械学習モデルの改善に使われる前提で、フレーズは自然な言い方を選ぶとよい。
            }
        }
    }

    @Section(title: "次のステップ") {
        @ContentAndMedia {
            Tutorial 2 で作ったMemoの2つのIntent（追加・完了）に、
            具体的な話しかけるフレーズを設定してもらう。
        }

        @Steps {
            @Step {
                理解できたらこれをコピペする。

                @Code(file: "03-prompt.txt", name: "prompt.txt")
            }
        }
    }
}
