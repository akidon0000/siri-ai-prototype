@Tutorial(time: 15) {
    @Intro(title: "SiriKitの限界") {
        SiriKit / Intents / IntentsUI フレームワークが何をしていたか、
        実際のコードで何が面倒だったか、そしてApp Intentsがそれをどう解決したかを
        手を動かして理解する。

        教材: `docs/sirikit/sirikit.md`（Apple Developer Documentation原文）
    }

    @Section(title: "SiriKit時代のintentハンドラ") {
        @ContentAndMedia {
            SiriKitでは、カスタムintentを作るたびに `.intentdefinition` ファイルで
            スキーマを定義し、生成されたプロトコルに対して「resolve → confirm → handle」
            の3段階を自分で実装する必要があった。
        }

        @Steps {
            @Step {
                `CompleteMemoIntentHandling` に準拠するクラスを書くと、まず
                `resolveMemo` でパラメータが欠けていないか確認するコードが必要になる。
                ここで `.needsValue()` を返すと、Siriが聞き返してくれる。

                @Code(file: "01-sirikit-custom-intent.swift", name: "CompleteMemoIntentHandler.swift")
            }

            @Step {
                次に `confirm` で「このまま実行してよいか」の最終確認を返す。
                多くの場合は `.ready` を返すだけだが、このメソッド自体を
                省略することはできない。
            }

            @Step {
                最後に `handle` で実際の処理を行い、`CompleteMemoIntentResponse` を返す。
                1つの操作を公開するだけで、クラス1つ・3つのメソッド・
                `.intentdefinition` の編集が必要だった。
            }
        }
    }

    @Section(title: "App Intentsなら1つの型で済む") {
        @ContentAndMedia {
            同じ「メモを完了にする」という操作を、App Intentsで書き直すとこうなる。
            resolve/confirm/handleの分割も、別ファイルのスキーマ定義も不要になった。
        }

        @Steps {
            @Step {
                `AppIntent` に準拠した構造体を1つ書くだけで、パラメータ
                （`memo`）と実行本体（`perform()`）の両方が揃う。
                パラメータの型は `MemoEntity`（第2章で作る）で、Siriは
                この型を見て「メモを指す言葉」をここに当てはめてくれる。

                @Code(file: "01-appintents-equivalent.swift", name: "CompleteMemoIntent.swift")
            }

            @Step {
                `perform()` の中で値が足りないケースは、`throw` で
                `AppIntentError` を投げれば、Siriがそれを会話の中で
                person に伝え直してくれる。resolve専用のメソッドを
                自分で書く必要はない。
            }

            @Step {
                公式ドキュメントも、新規実装ではSiriKitではなくApp Intentsフレームワークを
                使うよう明記している。SiriKitにはそもそも `AppEntity` や
                `donation`（第4章）のような、Apple IntelligenceやSiri AIが前提とする
                仕組みが存在しない。
            }
        }
    }

    @Section(title: "次のステップ") {
        @ContentAndMedia {
            ここまでの内容に納得できたら、下のプロンプトをコピーしてClaude Codeに貼り付けてよい。
            実装を依頼するものではなく、方針の確認と次章への準備だけを行う。
        }

        @Steps {
            @Step {
                理解できたらこれをコピペする。

                @Code(file: "01-prompt.txt", name: "prompt.txt")
            }
        }
    }
}
