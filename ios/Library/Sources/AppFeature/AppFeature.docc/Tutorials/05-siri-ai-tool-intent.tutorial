@Tutorial(time: 25) {
    @Intro(title: "Siri AI Developer PreviewのToolIntent") {
        App IntentをSiriが自律的に呼び出せる「ツール」として公開する、
        Siri AI Developer Preview固有の仕組みを、実際のマクロとファイル構成で理解する。

        教材: `docs/apple-intelligence/siri-ai-developer-preview.md`
        （Apple Developer Documentation原文）
    }

    @Section(title: "既存のAppIntentをツールにする") {
        @ContentAndMedia {
            通常のスキーマ対応だけでなく、アプリ独自のカスタムアクション・情報も
            Siriが見つけて実行できるようになる。そのための入口がツール化のマクロ。
        }

        @Steps {
            @Step {
                既存の `AppIntent` に `@AppIntent(.tool)` を付けるだけでよい。
                新しいentitlementの追加や、別プログラムへの参加は不要。
                `title` と `description`、各 `@Parameter` の `description` は
                Siriが他のintentと区別し、何を渡せばよいかを理解する手がかりになる。

                @Code(file: "05-tool-intent.swift", name: "CompleteMemoIntent.swift")
            }

            @Step {
                すでに `.messages.sendMessage` のような
                「スキーマ」に対応しているintentには `@AppIntent(.tool)` を
                付けない。スキーマ採用自体がSiriへの公開を意味するので、
                二重に指定する必要はない。
            }

            @Step {
                `perform()` を持たない `WidgetConfigurationIntent` のような
                「設定専用」のintentも、ツール化の対象にはしない。
                Siriが呼んでも実行すべき操作が存在しないため。
            }
        }
    }

    @Section(title: "Siriに値を直接組み立ててもらう: GenerableEntity") {
        @ContentAndMedia {
            「優先度高の買い物メモを探して」のような曖昧な発話を、
            アプリに問い合わせる前にSiri自身がパラメータとして組み立てられると、
            やりとりが1往復減る。
        }

        @Steps {
            @Step {
                検索条件のような「アプリのデータベースに存在しない一時的な値」は
                `TransientAppEntity` にし、`@AppEntity(.generable)` を付ける。
                各プロパティに `description` を与えることで、Siriが発話から
                どの値をどこに当てはめるかを判断できるようになる。

                @Code(file: "05-generable-entity.swift", name: "MemoSearch.swift")
            }

            @Step {
                生成対象のプロパティ自身も、Generableな型（`String` や
                第2章の `MemoPriority` のようなApp Enumなど）である必要がある。
            }
        }
    }

    @Section(title: "見せてよい範囲を細かく指定する") {
        @ContentAndMedia {
            メモの本文のような情報は、Shortcutsの結果画面にそのまま出てよいとは
            限らない。プロパティ単位・Entity単位で公開範囲を絞れる。
        }

        @Steps {
            @Step {
                Entity全体の既定ポリシーは `static let authenticationPolicy` で、
                個別プロパティは `@Property` に `authenticationPolicy` を渡すことで
                上書きできる。アプリ内部でしか使わない値は
                `visibility: .internal` にすると、Siri・Shortcutsには一切出てこない。

                @Code(file: "05-authentication-policy.swift", name: "MemoDetail.swift")
            }

            @Step {
                intentの結果そのものが機微な情報を含む場合は、
                プロパティ単位ではなくintentレベルで認証を要求する。
                プロパティの `authenticationPolicy` はSiriの「応答」にのみ効く。
            }
        }
    }

    @Section(title: "複数のツールをまとめて導く: app skill") {
        @ContentAndMedia {
            1つのツールintentは1つの操作しかしない。複数のintentを順序立てて
            使うような複雑な依頼には、追加のガイダンス（app skill）が要る。
            `name` と `description` のfrontmatter + Markdown本文という形式は、
            Claude Codeの `.claude/skills/*/SKILL.md` と同じ発想。
        }

        @Steps {
            @Step {
                XcodeでSkills Bundleテンプレートから `Skills.skillsbundle` を
                追加すると、`Skills/` フォルダができる。1つのapp skillにつき
                1つのサブフォルダを作り、その中に `SKILL.md` を1つだけ置く。

                @Code(file: "05-skill-structure.txt", name: "Skills.skillsbundle")
            }

            @Step {
                `SKILL.md` の先頭には `name`（ディレクトリ名と一致させる）と
                `description`（Siriがこのスキルを選ぶかどうかの判断に使う、
                1行・1024文字以内）をfrontmatterで書く。本文には、
                どのツールintentをどの順で使うか、何をしてはいけないかを
                自由形式で書く。コードが既に説明している情報
                （intent名そのものなど）は繰り返さない。

                @Code(file: "05-skill-md.txt", name: "memo-add/SKILL.md")
            }

            @Step {
                app skillは「このまま順番に実行させる」ための決定的な手順書ではない。
                Siri AIが複雑な依頼に応えるときの追加情報として使われるだけで、
                書いた通りに必ず実行される保証はない。
            }
        }
    }

    @Section(title: "次のステップ") {
        @ContentAndMedia {
            Tutorial 2〜4で作ったMemoのIntentをToolIntent化し、app skillを
            1つ用意してもらう。Siri AI Developer PreviewはApple Intelligence対応の
            デバイス/シミュレータでのみ動作する点に注意。
        }

        @Steps {
            @Step {
                理解できたらこれをコピペする。

                @Code(file: "05-prompt.txt", name: "prompt.txt")
            }
        }
    }
}
