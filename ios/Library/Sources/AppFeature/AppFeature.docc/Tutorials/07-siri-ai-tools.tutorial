@Tutorial(time: 50) {
    @Intro(title: "Siri AI Developer Preview: ツールとapp skill") {
        Siri AI Developer Previewでは、スキーマに当てはまらないアプリ独自の操作とデータも、
        Siriが見つけて実行できるようになる。その入口が、App Intentを「ツール」にする `@AppIntent(.tool)` と、
        複数のツールの使い方を教える「app skill」。

        この章のAPIと機能は、全てSiri AI Developer Preview（iOS 27.3 beta）で入ったもの。
        正式版までに名前や挙動が変わることがある。

        教材: `docs/apple-doc/apple-intelligence/siri-ai-developer-preview.md`、
        [Siri AI Developer Preview](https://developer.apple.com/documentation/appintents/siri-ai-developer-preview)、
        [Bringing custom actions and content to Siri](https://developer.apple.com/documentation/appintents/bringing-custom-actions-and-content-to-siri)、
        [Orchestrating complex actions with app skills](https://developer.apple.com/documentation/appintents/orchestrating-complex-actions-with-app-skills)
    }

    @Section(title: "ツールにするintentを選ぶ") {
        @ContentAndMedia {
            どのintentをツールにするかはアプリが決める。全てをツールにすればよいわけではない。
            判断の基準は [ToolIntent](https://developer.apple.com/documentation/appintents/toolintent) にまとまっている。
            ここでは、この章で扱うintentを「ツールにする（○）」「しない（×）」に分けて並べる。
            中身は後のセクションで書く。
        }

        @Steps {
            @Step {
                向いているのは、1文で頼めて、その文からパラメータを埋められる操作。
                「牛乳のメモを優先度高にして」なら、メモと優先度の両方が1文に入っている。
                この「優先度を変える」をツールにする。

                @Code(name: "ToolCandidates.swift", file: "ToolCandidates-01.swift")
            }

            @Step {
                第5章でSiriが使えるスキーマ（`createReminder` など）に合わせたintentには、ツールの指定を付けない。
                スキーマに合わせた時点でSiriに公開されていて、付けるとビルドエラーになる。
                例外はShortcuts専用ドメインのスキーマで、これは後の参考セクションで扱う。

                @Code(name: "ToolCandidates.swift", file: "ToolCandidates-02.swift", previousFile: "ToolCandidates-01.swift")
            }

            @Step {
                ウィジェットの設定用intentのように実行する操作を持たないもの、
                ショートカットの途中の1手順としてしか意味を持たないもの、
                注文と支払いのように人が明示的に始めるべき副作用を持つものも、ツールにしない。
                `WidgetConfigurationIntent` でも、`perform()` で独自の操作をしているならツールにできる。

                @Code(name: "ToolCandidates.swift", file: "ToolCandidates-03.swift", previousFile: "ToolCandidates-02.swift")
            }

            @Step {
                Memoアプリでは、作成・更新・削除は第5章のスキーマで公開済み。
                スキーマに無い「優先度を変える」に加えて、「条件でメモを探す」もツールにする。

                @Code(name: "ToolCandidates.swift", file: "ToolCandidates-04.swift", previousFile: "ToolCandidates-03.swift")
            }
        }
    }

    @Section(title: "ツールを作る") {
        @ContentAndMedia {
            優先度を変える `SetMemoPriorityIntent` を、普通のApp Intentとして作ってからツールにする。
        }

        @Steps {
            @Step {
                `AppIntent` に準拠した構造体と `title` を書く。

                @Code(name: "SetMemoPriorityIntent.swift", file: "SetMemoPriorityIntent-01.swift")
            }

            @Step {
                対象のメモと新しい優先度を `@Parameter` で受け取る。

                @Code(name: "SetMemoPriorityIntent.swift", file: "SetMemoPriorityIntent-02.swift", previousFile: "SetMemoPriorityIntent-01.swift")
            }

            @Step {
                `perform()` を書く。ここまでは第2章と同じ普通のApp Intent。

                @Code(name: "SetMemoPriorityIntent.swift", file: "SetMemoPriorityIntent-03.swift", previousFile: "SetMemoPriorityIntent-02.swift")
            }

            @Step {
                型の上に `@AppIntent(.tool)` を付ける。変更はこの1行だけ。
                [AppIntent(_:)](https://developer.apple.com/documentation/appintents/appintent(_:)) マクロは、
                型に `ToolIntent` への準拠を足す。型に `@available` があればそれを、無ければ `ToolIntent` 側の
                availabilityを引き継ぐ。

                @Code(name: "SetMemoPriorityIntent.swift", file: "SetMemoPriorityIntent-04.swift", previousFile: "SetMemoPriorityIntent-03.swift")
            }

            @Step {
                マクロに渡している `.tool` は
                [AppIntentTraits](https://developer.apple.com/documentation/appintents/appintenttraits) の値で、
                intentが担う役割を表す。`.tool` のように1つでも、`[.tool]` のように配列でも書ける。
                マクロは書かれたままの値を読むので、変数や計算した値は渡せない。

                @Code(name: "SetMemoPriorityIntent.swift", file: "SetMemoPriorityIntent-05.swift", previousFile: "SetMemoPriorityIntent-04.swift")
            }

            @Step {
                `description` と、各 `@Parameter` の `description` を足す。Siriのモデルは、
                これらを読んでツールが何をするか・何を渡せばよいかを判断する。
                アプリを知らない人に向けて書き、文字列の形式・数値の範囲・単位があれば書いておく
                （[ToolIntent](https://developer.apple.com/documentation/appintents/toolintent)、
                [Bringing custom actions and content to Siri](https://developer.apple.com/documentation/appintents/bringing-custom-actions-and-content-to-siri)）。

                @Code(name: "SetMemoPriorityIntent.swift", file: "SetMemoPriorityIntent-06.swift", previousFile: "SetMemoPriorityIntent-05.swift")
            }
        }
    }

    @Section(title: "Siriがツールを呼べる場面") {
        @ContentAndMedia {
            作ったツールがいつでも呼ばれるわけではない。Siriがアプリのツールを使うのは、
            そのアプリが会話に関係していると判断できるときに限られる。
        }

        @Steps {
            @Step {
                アプリが前面にあるとき、Live Activityが動いているとき、Siriアプリでの会話にアプリが出てきたときは、
                アプリ名を言わなくてもツールが使われる。例: 配車アプリのLive Activityを見ながら
                「迎えの場所を変えて」と言う
                （[Siri AI Developer Preview](https://developer.apple.com/documentation/appintents/siri-ai-developer-preview)）。

                @Code(name: "SetMemoPriorityIntent.swift", file: "SetMemoPriorityIntent-07.swift", previousFile: "SetMemoPriorityIntent-06.swift")
            }

            @Step {
                アプリが後ろにあるときは、依頼にアプリ名が入っていればツールが使われる。
                また、そのアプリのEntityが検索結果に出てきたときにも使われる
                （[ToolIntent](https://developer.apple.com/documentation/appintents/toolintent)）。
                `MemoEntity` を第6章でSpotlight索引に入れておいたことが、ここで効く。

                @Code(name: "SetMemoPriorityIntent.swift", file: "SetMemoPriorityIntent-08.swift", previousFile: "SetMemoPriorityIntent-07.swift")
            }

            @Step {
                Developer Previewは、Apple Intelligence対応デバイスのiOS・iPadOS・macOS・visionOSで動く。
                試せるのは、開発用プロファイルで署名して実機で動かす場合と、TestFlightの内部テスターだけ。
                外部テスターやApp Store版では動かない。新しいentitlementの追加や別プログラムへの参加は要らない。
                配布中のアプリに足すときは、型に `@available(iOS 27.3, *)` を付けて、古いOSでは使わないようにする。

                @Code(name: "SetMemoPriorityIntent.swift", file: "SetMemoPriorityIntent-09.swift", previousFile: "SetMemoPriorityIntent-08.swift")
            }
        }
    }

    @Section(title: "参考: Shortcuts専用スキーマをツールにする") {
        @ContentAndMedia {
            Shortcutsアプリでだけ使えるドメイン（Journaling・Booksなど）のスキーマは、Siriには公開されない。
            これらのスキーマに合わせたintentは、
            [AppIntent(_:schema:)](https://developer.apple.com/documentation/appintents/appintent(_:schema:))
            でツールにもできる。Memoアプリには当てはまるドメインが無いので、日記アプリを例にする。
        }

        @Steps {
            @Step {
                Journalingドメインの `createEntry` スキーマに合わせたintentを作る。
                `message` と `title` から書き始める。

                @Code(name: "CreateJournalEntryIntent.swift", file: "CreateJournalEntryIntent-01.swift")
            }

            @Step {
                スキーマが定める残りのプロパティ `location`・`mediaItems`・`entryDate` を足す。

                @Code(name: "CreateJournalEntryIntent.swift", file: "CreateJournalEntryIntent-02.swift", previousFile: "CreateJournalEntryIntent-01.swift")
            }

            @Step {
                `perform()` で日記を作り、作った日記のEntityを返す。この時点では
                Shortcutsアプリでしか使えない。

                @Code(name: "CreateJournalEntryIntent.swift", file: "CreateJournalEntryIntent-03.swift", previousFile: "CreateJournalEntryIntent-02.swift")
            }

            @Step {
                `@AppIntent(schema:)` を `@AppIntent(.tool, schema:)` に置き換える。
                `@AppIntent(schema:)` が付けるものは全てそのまま付き、それに加えて `ToolIntent` への準拠が付く。
                Siriで使えるドメイン（`.messages.sendMessage` など）のスキーマにこの書き方をするとビルドエラーになる。

                @Code(name: "CreateJournalEntryIntent.swift", file: "CreateJournalEntryIntent-04.swift", previousFile: "CreateJournalEntryIntent-03.swift")
            }
        }
    }

    @Section(title: "Siriに値を組み立ててもらう") {
        @ContentAndMedia {
            「優先度が高い買い物のメモを探して」のような依頼では、検索条件そのものは
            アプリのデータベースに存在しない。こうした値は、Siriが依頼の文から直接組み立てられるようにする
            （[GenerableEntity](https://developer.apple.com/documentation/appintents/generableentity)）。
        }

        @Steps {
            @Step {
                検索条件を表す `MemoSearch` を `TransientAppEntity` として作り、`@AppEntity(.generable)` を付ける。
                [AppEntity(_:)](https://developer.apple.com/documentation/appintents/appentity(_:)) マクロが
                `GenerableEntity` への準拠を足し、Siriはクエリを呼ばずにこの値を作れるようになる。
                マクロを付けられるのは `TransientAppEntity` に準拠した型だけ。

                @Code(name: "MemoSearch.swift", file: "MemoSearch-01.swift")
            }

            @Step {
                `.generable` は
                [AppEntityTraits](https://developer.apple.com/documentation/appintents/appentitytraits) の値。
                `AppIntentTraits` と同じく、`.generable` でも `[.generable]` でも書けて、計算した値は渡せない。
                スキーマに合わせた一時的なEntityをGenerableにしたいときは、`@AppEntity(schema:)` の代わりに
                [AppEntity(_:schema:)](https://developer.apple.com/documentation/appintents/appentity(_:schema:))
                を使い、`@AppEntity(.generable, schema: ...)` と書く。

                @Code(name: "MemoSearch.swift", file: "MemoSearch-02.swift", previousFile: "MemoSearch-01.swift")
            }

            @Step {
                プロパティを `@Property` で宣言し、それぞれに `description` を付ける。
                Siriはこの説明を見て、依頼のどの部分をどのプロパティに入れるかを決める。
                Generableなエンティティのプロパティにできるのは、`String` などの値型・App Enum・
                別のGenerableなエンティティ・それらの配列だけで、それ以外の型はコンパイルエラーになる。
                優先度を配列にしているのはこのため。

                @Code(name: "MemoSearch.swift", file: "MemoSearch-03.swift", previousFile: "MemoSearch-02.swift")
            }

            @Step {
                `displayRepresentation` と、システムが値を作るための `init()` を足す。

                @Code(name: "MemoSearch.swift", file: "MemoSearch-04.swift", previousFile: "MemoSearch-03.swift")
            }

            @Step {
                `MemoSearch` を受け取るツール `FindMemosIntent` を作る。

                @Code(name: "FindMemosIntent.swift", file: "FindMemosIntent-01.swift")
            }

            @Step {
                `description` と、`MemoSearch` 型のパラメータを足す。

                @Code(name: "FindMemosIntent.swift", file: "FindMemosIntent-02.swift", previousFile: "FindMemosIntent-01.swift")
            }

            @Step {
                `perform()` で検索結果の `MemoEntity` の配列を返す。返したメモは、
                次に呼ぶ `SetMemoPriorityIntent` や `UpdateMemoIntent` にそのまま渡される。
                パラメータの型が `MemoEntity` のようにアプリが持つEntityなら、
                Siriは組み立てずに `MemoQuery` で探す。

                @Code(name: "FindMemosIntent.swift", file: "FindMemosIntent-03.swift", previousFile: "FindMemosIntent-02.swift")
            }
        }
    }

    @Section(title: "見せてよい範囲を決める") {
        @ContentAndMedia {
            Entityの情報は、既定では認証なしでSiriやShortcutsに表示される。
            見られたくない値はプロパティごとに制限する
            （[Bringing custom actions and content to Siri](https://developer.apple.com/documentation/appintents/bringing-custom-actions-and-content-to-siri)）。
        }

        @Steps {
            @Step {
                鍵付きメモの本文を `@Property` で足し、`authenticationPolicy` に
                `.requiresLocalDeviceAuthentication` を指定する。Siriは本文を含む応答の前に端末の認証を求める。
                Entity全体の既定は `static let authenticationPolicy` で決め、プロパティ側で上書きする。
                プロパティの指定が効くのはSiriの応答だけなので、intentの結果そのものが機微な情報なら、
                intentの側で認証を要求する。

                @Code(name: "MemoEntity.swift", file: "MemoEntity-12.swift", previousFile: "MemoEntity-11.swift")
            }

            @Step {
                同期用のリビジョン番号のように、アプリの外では意味が無い値には `visibility: .internal` を付ける。
                [IntentVisibility](https://developer.apple.com/documentation/appintents/intentvisibility) には
                Siri・Shortcutsにも見せる `.default` と、アプリとそのextension（ウィジェットなど）だけに見せる
                `.internal` がある。`.internal` を `indexingKey` や `customIndexingKey` と一緒に使うと
                Spotlightから見えてしまうので、併用しない。

                @Code(name: "MemoEntity.swift", file: "MemoEntity-13.swift", previousFile: "MemoEntity-12.swift")
            }
        }
    }

    @Section(title: "Siriに見せるプロパティを増やす: ComputedPropertyとDeferredProperty") {
        @ContentAndMedia {
            保存しているプロパティだけでは、Siriが答えられる質問は限られる。
            「期限切れのメモは？」に答えるには、保存していない値も見せる必要がある。
            計算で出せる値は `@ComputedProperty`、取得に時間がかかる値は `@DeferredProperty` で公開する。
        }

        @Steps {
            @Step {
                `@ComputedProperty` で、期限切れかどうかを返す `isOverdue` を足す。getアクセサ（必要ならsetも）を持つ
                計算プロパティを、Siriやショートカットが読めるEntityのプロパティにする
                （[ComputedProperty(title:description:authenticationPolicy:visibility:)](https://developer.apple.com/documentation/appintents/computedproperty(title:description:authenticationpolicy:visibility:))）。
                `@Property` と同じく `title`・`description`・`authenticationPolicy`・`visibility` を指定できる。

                @Code(name: "MemoEntity.swift", file: "MemoEntity-14.swift", previousFile: "MemoEntity-13.swift")
            }

            @Step {
                メモ本文のテキストを返す `noteText` を足し、`indexingKey: \.contentDescription` を指定する。
                値がSpotlightの既存の属性 `contentDescription` として索引に入り、第6章のセマンティック検索で本文が引っかかる
                （[ComputedProperty(…, indexingKey:)](https://developer.apple.com/documentation/appintents/computedproperty(title:description:authenticationpolicy:visibility:indexingkey:))）。
                キーの型 `CSSearchableItemAttributeSet` を使うので `CoreSpotlight` をimportする。

                @Code(name: "MemoEntity.swift", file: "MemoEntity-15.swift", previousFile: "MemoEntity-14.swift")
            }

            @Step {
                Spotlightに該当する属性が無い値は、`customIndexingKey` にアプリ独自のキーを渡す。
                ここではリスト名を `CSCustomAttributeKey` で索引に入れる
                （[ComputedProperty(…, customIndexingKey:)](https://developer.apple.com/documentation/appintents/computedproperty(title:description:authenticationpolicy:visibility:customindexingkey:))）。
                キー名は他のアプリと衝突しないよう、アプリと型の名前を含める。

                @Code(name: "MemoEntity.swift", file: "MemoEntity-16.swift", previousFile: "MemoEntity-15.swift")
            }

            @Step {
                共有相手の名前のように、サーバーへの問い合わせが要る値は `@DeferredProperty` にし、
                `get async` で返す。値はSiriが必要としたときだけ取りに来る
                （[DeferredProperty(title:description:authenticationPolicy:visibility:)](https://developer.apple.com/documentation/appintents/deferredproperty(title:description:authenticationpolicy:visibility:))）。
                ここでは `authenticationPolicy` で認証も求めている。

                @Code(name: "MemoEntity.swift", file: "MemoEntity-17.swift", previousFile: "MemoEntity-16.swift")
            }

            @Step {
                `indexingKey` を付けない `@DeferredProperty` は、`IndexedEntity` を索引に入れるときに含まれない。
                さっきの `collaboratorNames` も索引には入らない。索引に入れたいときは
                [DeferredProperty(…, indexingKey:)](https://developer.apple.com/documentation/appintents/deferredproperty(title:description:authenticationpolicy:visibility:indexingkey:))
                を使う。ここでは添付画像から読み取った文字を `textContent` として索引に入れる。
                Spotlightは索引を作るたびに値を取りに来るので、取得が重いと索引作成も遅くなる
                （[Making app entities available in Spotlight](https://developer.apple.com/documentation/appintents/making-app-entities-available-in-spotlight)）。

                @Code(name: "MemoEntity.swift", file: "MemoEntity-18.swift", previousFile: "MemoEntity-17.swift")
            }
        }
    }

    @Section(title: "Siriにカスタムの内容を見つけてもらう") {
        @ContentAndMedia {
            ツールを作っても、Siriがパラメータに入れるEntityを見つけられなければ使われない。
            [Bringing custom actions and content to Siri](https://developer.apple.com/documentation/appintents/bringing-custom-actions-and-content-to-siri)
            は、カスタムの操作とデータをSiriに届けるための準備として、次の点を挙げている。
            使うAPIはどれも以前からあるもので、Developer Previewのツールからもそのまま効く。
        }

        @Steps {
            @Step {
                Entityを見つけられるようにする。第6章のSpotlight索引に入れるのが基本になる。
                索引に入れないEntityは、件数が少なければ `EnumerableEntityQuery` で全件を返せばよい。
                第5章で用意した `MemoListQuery` を、`allEntities()` で全てのリストを返すクエリにする。

                @Code(name: "MemoListQuery.swift", file: "MemoListQuery-01.swift")
            }

            @Step {
                `EnumerableEntityQuery` も `EntityQuery` の一種なので、IDからリストを返す `entities(for:)` も書く。

                @Code(name: "MemoListQuery.swift", file: "MemoListQuery-02.swift", previousFile: "MemoListQuery-01.swift")
            }

            @Step {
                もう1つの方法は、パラメータに `DynamicOptionsProvider` で選択肢を出すこと。
                `results()` が返したメモの中から、Siriはパラメータの値を選べる。
                使う側の `@Parameter` には `optionsProvider:` でこの型を渡す。

                @Code(name: "PinnedMemosOptionsProvider.swift", file: "PinnedMemosOptionsProvider-01.swift")
            }

            @Step {
                第6章の画面の注釈とdonationは、スキーマに合わせていないカスタムのEntityやintentにもそのまま使える。
                「このメモ」のような指示語や、あいまいな依頼の解釈に効く。
                まず `MemoListModel` に、画面の優先度メニューから呼ぶ処理を足す。

                @Code(name: "MemoListModel.swift", file: "MemoListModel-05.swift", previousFile: "MemoListModel-04.swift")
            }

            @Step {
                第6章の `CreateMemoIntent` と同じように、ツールの `SetMemoPriorityIntent` を組み立ててdonateする。
                渡す結果が無いので、`result:` を省いた `donate(intent:)` を使う。

                @Code(name: "MemoListModel.swift", file: "MemoListModel-06.swift", previousFile: "MemoListModel-05.swift")
            }

            @Step {
                あるアプリのEntityを別のアプリへ渡すには、Entityを `Transferable` に準拠させておく（第6章）。
                「このメモをメールで送って」は、Memoアプリの `MemoEntity` がメールアプリで読める形に変換できて初めて成り立つ。

                @Code(name: "MemoEntity+Transferable.swift", file: "MemoEntity+Transferable-03.swift", previousFile: "MemoEntity+Transferable-02.swift")
            }
        }
    }

    @Section(title: "複数のツールを使う手順を教える: app skill") {
        @ContentAndMedia {
            1つのツールは1つの操作しかしない。「溜まったメモを整理して」のような依頼では、
            探す・完了にする・優先度を変えるを組み合わせる必要があるが、個々のツールの説明だけでは
            Siriが組み合わせ方を判断できないことがある。そこで、追加の指示をapp skillとして渡す
            （[Orchestrating complex actions with app skills](https://developer.apple.com/documentation/appintents/orchestrating-complex-actions-with-app-skills)）。
            形式は `name` と `description` のfrontmatterとMarkdownの本文で、Claude Codeの
            `.claude/skills/*/SKILL.md` と同じ形をしている。
        }

        @Steps {
            @Step {
                Xcodeの File > New > File from Template で Skills Bundle を選び、名前は `Skills` のまま、
                アプリのターゲットに追加する。1つのスキルにつきフォルダを1つ作り、中に `SKILL.md` だけを置く。
                アプリのターゲットに置ける `.skillsbundle` は1つだけで、
                Copy Bundle Resourcesに入っていないとSiriに渡らない。

                @Code(name: "Skills.skillsbundle", file: "SkillsBundle-01.txt")
            }

            @Step {
                frontmatterに `name` と `description` を書く。`name` は小文字・数字・ハイフンの1〜64文字で、
                フォルダ名と一致させる。`description` は1行・1024文字以内。
                Siriはまず `description` だけを読んで、このスキルを使うかどうかを決める。

                @Code(name: "memo-triage/SKILL.md", file: "MemoTriageSkill-01.txt")
            }

            @Step {
                本文に手順を書く（10,000文字まで）。intentは `SetMemoPriorityIntent` のような型名ではなく、
                「優先度を変えるツール」のように役割で呼ぶ。titleやdescriptionなど、
                コードに既に書いてあることは繰り返さない。

                @Code(name: "memo-triage/SKILL.md", file: "MemoTriageSkill-02.txt", previousFile: "MemoTriageSkill-01.txt")
            }

            @Step {
                やってはいけないことも書ける。ただしapp skillは決まった順で実行させる仕組みではない。
                Siriが判断に使う追加情報で、書いた通りの順に必ずツールが呼ばれるわけではない。
                動作の確認は、シミュレータではなく実機かTestFlightの内部テストで行う。

                @Code(name: "memo-triage/SKILL.md", file: "MemoTriageSkill-03.txt", previousFile: "MemoTriageSkill-02.txt")
            }
        }
    }

    @Section(title: "Siri Integration Advisor") {
        @ContentAndMedia {
            Developer PreviewのXcodeには、App Intentsの実装を読んでSiri向けの改善点を示す
            Siri Integration Advisorが入っている
            （[Bringing custom actions and content to Siri](https://developer.apple.com/documentation/appintents/bringing-custom-actions-and-content-to-siri)）。
        }

        @Steps {
            @Step {
                Siriがアプリ独自の操作とデータを扱えるようにするための指摘と提案が出る
                （具体的に何を指摘するかは公式ドキュメントに一覧が無いので、実装後にXcodeで確認する）。
                コードを書いたら、第8章の自動テストに進む前にAdvisorの指摘を片付けておく。
            }
        }
    }

    @Section(title: "次のステップ") {
        @ContentAndMedia {
            スキーマに無い操作をツールにし、app skillを1つ用意してもらう。
        }

        @Steps {
            @Step {
                理解できたらこれをClaude Codeに貼る。実装から、ビルドと動作確認までを任せる。

                @Code(name: "prompt.txt", file: "07-prompt.txt")
            }
        }
    }
}
