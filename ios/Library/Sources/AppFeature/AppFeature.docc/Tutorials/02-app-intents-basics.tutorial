@Tutorial(time: 25) {
    @Intro(title: "App Intentsの基礎") {
        App Entity（データ）・Entity Query（データの探し方）・App Enum（選択肢）・
        App Intent（操作）の4つを、Memoアプリを題材に1行ずつ組み立てる。
        ここで作る `MemoEntity` と `AddMemoIntent` は、第4章以降でも同じファイルを育てていく。

        教材: `docs/apple-doc/app-intents/app-intents.md`、
        [App Intents](https://developer.apple.com/documentation/appintents)、
        [Defining app entities for your custom data types](https://developer.apple.com/documentation/appintents/defining-app-entities-for-your-custom-data-types)
    }

    @Section(title: "App Entity: データをシステムに見せる") {
        @ContentAndMedia {
            App Entityは、アプリのデータのうちSiriやShortcutsから参照されうる部分を表す型。
            Memoアプリなら、メモ1件が `MemoEntity` になる。データベースの行をそのまま公開するのではなく、
            人が口にしそうな情報（タイトル・完了状態）に絞って軽く作る。
        }

        @Steps {
            @Step {
                `AppEntity` に準拠する構造体と、3つのプロパティを書く。`id` はEntityを一意に識別する値で、
                Siriやショートカットはこの `id` だけを保存しておき、後で本体を取りに来る。
                この時点ではプロトコルの要件が足りないのでビルドは通らない。

                @Code(name: "MemoEntity.swift", file: "MemoEntity-01.swift")
            }

            @Step {
                `typeDisplayRepresentation` を足す。「メモ」という型そのものの呼び名で、
                Shortcutsのパラメータ欄やSiriの聞き返し（「どのメモ？」）に使われる。

                @Code(name: "MemoEntity.swift", file: "MemoEntity-02.swift", previousFile: "MemoEntity-01.swift")
            }

            @Step {
                `displayRepresentation` を足す。こちらは1件ごとの見え方で、ここではタイトルだけを返す。
                サブタイトルや画像は第4章で足す。

                @Code(name: "MemoEntity.swift", file: "MemoEntity-03.swift", previousFile: "MemoEntity-02.swift")
            }

            @Step {
                最後に `defaultQuery` を足す。システムが `id` から `MemoEntity` を取り直すときの窓口で、
                次のセクションで作る `MemoQuery` を指す。これでAppEntityの要件が揃う。

                @Code(name: "MemoEntity.swift", file: "MemoEntity-04.swift", previousFile: "MemoEntity-03.swift")
            }
        }
    }

    @Section(title: "Entity Query: データの探し方を教える") {
        @ContentAndMedia {
            Siriが「牛乳のメモを完了にして」と言われたとき、「牛乳のメモ」が実際にどの `MemoEntity` なのかを
            知る方法は、アプリが提供するクエリしかない。
        }

        @Steps {
            @Step {
                `EntityQuery` に準拠し、必須の `entities(for:)` を書く。保存しておいた `id` の配列から
                `MemoEntity` を返すメソッドで、ショートカットを実行するたびに呼ばれる。

                @Code(name: "MemoQuery.swift", file: "MemoQuery-01.swift")
            }

            @Step {
                `suggestedEntities()` を足す。Siriが「どのメモ？」と聞き返すときや、
                Shortcutsでパラメータを選ぶときに候補として並ぶ。最近のメモなど、選ばれやすいものに絞る。

                @Code(name: "MemoQuery.swift", file: "MemoQuery-02.swift", previousFile: "MemoQuery-01.swift")
            }

            @Step {
                準拠先を `EntityStringQuery` に変え、`entities(matching:)` を足す。
                人が言った「牛乳」という文字列から該当するメモを返せるようになり、
                Siriが名前でメモを探せるようになる。

                @Code(name: "MemoQuery.swift", file: "MemoQuery-03.swift", previousFile: "MemoQuery-02.swift")
            }
        }
    }

    @Section(title: "App Enum: 決まった選択肢を公開する") {
        @ContentAndMedia {
            メモの優先度のように値が決まっている型はApp Enumにする。
            Siriは「優先度高で」という言い方を、どのcaseに当たるかとして理解できるようになる。
        }

        @Steps {
            @Step {
                `String` のraw valueを持つenumを `AppEnum` に準拠させる。
                raw valueはショートカットに保存される値なので、後から変えないものを選ぶ。

                @Code(name: "MemoPriority.swift", file: "MemoPriority-01.swift")
            }

            @Step {
                型の呼び名 `typeDisplayRepresentation` を足す。

                @Code(name: "MemoPriority.swift", file: "MemoPriority-02.swift", previousFile: "MemoPriority-01.swift")
            }

            @Step {
                `caseDisplayRepresentations` で各caseの表示名を決める。
                Siriが読み上げ、聞き取るのはこの「低・通常・高」の方で、`low` などのcase名ではない。

                @Code(name: "MemoPriority.swift", file: "MemoPriority-03.swift", previousFile: "MemoPriority-02.swift")
            }
        }
    }

    @Section(title: "App Intent: 操作をカプセル化する") {
        @ContentAndMedia {
            「メモを追加する」を `AddMemoIntent` として定義する。ここまでに作った
            `MemoEntity` と `MemoPriority` を、パラメータと戻り値に使う。
        }

        @Steps {
            @Step {
                `AppIntent` に準拠し、`title` を付ける。関数名ではなくこの `title` を見て人が操作を探すので、
                短く具体的な言葉にする。

                @Code(name: "AddMemoIntent.swift", file: "AddMemoIntent-01.swift")
            }

            @Step {
                `description` を足す。Shortcutsアプリで操作の説明として表示されるほか、
                第7章のSiri AIでは、Siriがこのintentを使うかどうかを判断する材料にもなる。

                @Code(name: "AddMemoIntent.swift", file: "AddMemoIntent-02.swift", previousFile: "AddMemoIntent-01.swift")
            }

            @Step {
                必須の入力 `title` を `@Parameter` で宣言する。値が無いまま実行されると、
                システムが自動で聞き返す。

                @Code(name: "AddMemoIntent.swift", file: "AddMemoIntent-03.swift", previousFile: "AddMemoIntent-02.swift")
            }

            @Step {
                `priority` は `default: .normal` を付けて宣言する。人が優先度を言わなくても、
                聞き返さずに「通常」で追加できる。

                @Code(name: "AddMemoIntent.swift", file: "AddMemoIntent-04.swift", previousFile: "AddMemoIntent-03.swift")
            }

            @Step {
                `perform()` を書く。戻り値の型に `ReturnsValue<MemoEntity>` を含めると、
                追加したメモをShortcutsの次のアクションへ渡したり、Siriの応答に使ったりできる。

                @Code(name: "AddMemoIntent.swift", file: "AddMemoIntent-05.swift", previousFile: "AddMemoIntent-04.swift")
            }

            @Step {
                `parameterSummary` を足す。Shortcutsアプリでこのアクションが
                「〈タイトル〉を優先度〈通常〉で追加」という1文で表示され、文中の値をタップして編集できる。

                @Code(name: "AddMemoIntent.swift", file: "AddMemoIntent-06.swift", previousFile: "AddMemoIntent-05.swift")
            }
        }
    }

    @Section(title: "次のステップ") {
        @ContentAndMedia {
            Memo (id, title, isDone) を題材に、AppEntity・EntityQuery・AppEnum・AppIntentを
            `ios/Library` に実装してもらう。ここまでのコードは教材用で、まだパッケージには入っていない。
        }

        @Steps {
            @Step {
                理解できたらこれをClaude Codeに貼る。実装から、ビルドと動作確認までを任せる。

                @Code(name: "prompt.txt", file: "02-prompt.txt")
            }
        }
    }
}
