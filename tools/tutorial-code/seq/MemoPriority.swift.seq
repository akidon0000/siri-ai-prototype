#name MemoPriority.swift
1|import AppIntents
1|
1|// AppEnum にすると、Siriは決まった選択肢の中から値を選ぶ。フレーズにも埋め込める
1|enum MemoPriority: String, AppEnum {
1|    case low, normal, high
2|
2|    static let typeDisplayRepresentation: TypeDisplayRepresentation = "優先度"
3|
3|    static let caseDisplayRepresentations: [MemoPriority: DisplayRepresentation] = [
3|        .low: "低",
3|        .normal: "通常",
3|        .high: "高",
3|    ]
1|}
