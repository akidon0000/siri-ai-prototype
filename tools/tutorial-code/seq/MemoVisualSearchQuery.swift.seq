#name MemoVisualSearchQuery.swift
1|import AppIntents
1|import VisualIntelligence
1|
1|// ビジュアルインテリジェンスの検索を受けるクエリ。アプリに1つだけ置ける
1|struct MemoVisualSearchQuery: IntentValueQuery {
2|    func values(for input: SemanticContentDescriptor) async throws -> [MemoEntity] {
2|        // labels には「milk」のような英語のラベルが入る。翻訳も類義語の展開もされない
2|        try await MemoStore.shared.memos(matchingAnyOf: input.labels)
2|    }
1|}
