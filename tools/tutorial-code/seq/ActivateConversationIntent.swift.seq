#name ActivateConversationIntent.swift
1|import AppIntents
1|
1|// 日本でサイドボタンを長押ししたときに呼ばれる。entitlementの申請が要る
1|@AppIntent(schema: .assistant.activate)
1|struct ActivateConversationIntent {
1|    static let supportedModes: IntentModes = .foreground
2|
2|    func perform() async throws -> some IntentResult {
2|        await ConversationController.shared.startListening()
2|        return .result()
2|    }
1|}
