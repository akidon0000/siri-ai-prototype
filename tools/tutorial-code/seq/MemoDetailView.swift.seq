#name MemoDetailView.swift
1|import AppIntents
1|import SwiftUI
1|
1|struct MemoDetailView: View {
1|    let memo: MemoEntity
2|
2|    var body: some View {
2|        Text(memo.title)
3|            // 表示中のメモをNSUserActivityに載せ、「これ」がどのメモかをSiriに伝える
3|            // 無いと、画面を開いたまま「これを完了にして」と言っても、Siriは「どのメモですか」と聞き返す
3|            // 有効なのは、この画面が表示されている間だけ。閉じれば「これ」の対象からも外れる
3|            // Siriが使うのは appEntityIdentifier のID。種類の名前（末尾の .memo）は自分で決める識別子で、動作には関係しない
3|            .userActivity("com.akidon0000.SiriAIPrototype.memo") { activity in
3|                activity.title = memo.title
3|                activity.appEntityIdentifier = EntityIdentifier(for: MemoEntity.self, identifier: memo.id)
3|            }
2|    }
1|}
