ja|// PredictableIntent: 提案として表示されるときの文言を決められる
en|// PredictableIntent: lets you set the wording shown when it appears as a suggestion
ja|static let title: LocalizedStringResource = "メモを追加"
en|static let title: LocalizedStringResource = "Add Memo"
ja|// Shortcutsアプリでの説明。Siriもこれを読んでintentの役割を知る
en|// The description in the Shortcuts app. Siri also reads it to learn what the intent does
ja|static let description = IntentDescription("新しいメモを1件追加する。")
en|static let description = IntentDescription("Adds one new memo.")
ja|@Parameter(title: "タイトル")
en|@Parameter(title: "Title")
ja|// 値が無いとき、Siriはこの文で聞き返す
en|// When the value is missing, Siri asks with this sentence
ja|@Parameter(title: "タイトル", requestValueDialog: "どんなメモを追加しますか？")
en|@Parameter(title: "Title", requestValueDialog: "What memo do you want to add?")
ja|// AppEnumなので、Siriは「低・通常・高」の中から選ぶ。言われなければ通常
en|// It's an AppEnum, so Siri picks from Low, Normal and High. Normal if not said
ja|@Parameter(title: "優先度", default: .normal)
en|@Parameter(title: "Priority", default: .normal)
ja|// Shortcutsアプリでは、パラメータを埋め込んだこの1文として表示される
en|// The Shortcuts app shows the action as this one sentence with the parameters embedded
ja|// 対応する全ての言語で、自然な1文として読めるかをShortcutsアプリで確かめる
en|// Check in the Shortcuts app that it reads as one natural sentence in every supported language
ja|Summary("\(\.$title)を優先度\(\.$priority)で追加")
en|Summary("Add \(\.$title) with priority \(\.$priority)")
ja|DisplayRepresentation(title: "「\(title)」をメモに追加")
en|DisplayRepresentation(title: "Add '\(title)' to memos")
ja|// Shortcutsから実行すると、この行に置いたブレークポイントで止まる
en|// When run from Shortcuts, a breakpoint on this line stops here
ja|// 同じ名前のメモがあれば、その場で別の名前を聞き返す
en|// If a memo with the same name exists, ask for a different name right away
ja|title = try await $title.requestValue("同じ名前のメモがあります。別の名前にしますか？")
en|title = try await $title.requestValue("There's already a memo with that name. What name do you want instead?")
ja|// 作ったメモを返すと、ショートカットの次のアクションに渡せる
en|// Returning the new memo lets the next action in a shortcut use it
ja|// full は画面が無いときに読み上げる文、supporting は画面と一緒に出す短い文
en|// full is read aloud when there's no screen; supporting is a short line shown with the screen
ja|dialog: IntentDialog(full: "「\(memo.title)」をメモに追加しました。", supporting: "追加しました")
en|dialog: IntentDialog(full: "Added '\(memo.title)' to your memos.", supporting: "Added")
ja|dialog: IntentDialog(full: "「\(memo.title)」をメモに追加しました。", supporting: "追加しました"),
en|dialog: IntentDialog(full: "Added '\(memo.title)' to your memos.", supporting: "Added"),
ja|// ボタンを押せるスニペットは、ビューではなく SnippetIntent で返す
en|// A snippet with buttons is returned as a SnippetIntent, not a view
