ja|// アプリの型はimportしない。intentやEntityは名前の文字列で引く
en|// Don't import the app's types. Look up intents and entities by name strings
ja|// アプリが登録したintent・Entity・Enum・クエリを、バンドルIDから読み込む
en|// Load the intents, entities, enums and queries the app registered, from its bundle ID
ja|// どのテストも同じ初期データから始める
en|// Every test starts from the same initial data
ja|// SiriやShortcutsと同じ経路で、アプリの外からintentを実行する
en|// Run the intent from outside the app, through the same path as Siri and Shortcuts
ja|let result = try await definitions.intents["CreateMemoIntent"].makeIntent(title: "牛乳を買う").run()
en|let result = try await definitions.intents["CreateMemoIntent"].makeIntent(title: "Buy milk").run()
ja|XCTAssertEqual(title, "牛乳を買う")
en|XCTAssertEqual(title, "Buy milk")
ja|// Siriが名前を聞き取ったときと同じ探し方で、メモが見つかるか
en|// Whether the memo is found the same way Siri looks it up when it hears a name
ja|let memos = try await definitions.entities["MemoEntity"].entities(matching: "牛乳")
en|let memos = try await definitions.entities["MemoEntity"].entities(matching: "milk")
ja|let indexed = try await definitions.entities["MemoEntity"].spotlightQuery("牛乳")
en|let indexed = try await definitions.entities["MemoEntity"].spotlightQuery("milk")
